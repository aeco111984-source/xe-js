import { useEffect, useMemo, useState } from "react";
import currencies from "@/config/currencies.json";

export default function CurrencyPicker({ label, value, onChange }) {
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState("");

  // current currency object
  const current = useMemo(
    () => currencies.find((c) => c.code === value) || null,
    [value]
  );

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return currencies;
    return currencies.filter((c) => {
      return (
        c.code.toLowerCase().includes(q) ||
        c.name.toLowerCase().includes(q)
      );
    });
  }, [query]);

  // close on ESC
  useEffect(() => {
    function handleKey(e) {
      if (e.key === "Escape") setOpen(false);
    }
    if (open) window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, [open]);

  return (
    <div className="w-full">
      {label && (
        <label className="block text-lg mb-2 font-medium text-gray-700">
          {label}
        </label>
      )}
      {/* Display button */}
      <button
        type="button"
        onClick={() => setOpen(true)}
        className="w-full border rounded-md px-4 py-3 flex items-center justify-between text-[1.05rem] bg-white hover:bg-gray-50"
      >
        <span className="flex items-center gap-2">
          <span className="text-xl">
            {current?.flag || "🏳️"}
          </span>
          <span className="font-semibold">{current?.code || value}</span>
          <span className="text-gray-500 hidden sm:inline">
            — {current?.name || "Select currency"}
          </span>
        </span>
        <span className="text-gray-500 text-sm">▼</span>
      </button>

      {/* Modal picker */}
      {open && (
        <div className="fixed inset-0 bg-black/40 z-50 flex justify-center items-start pt-24 sm:pt-32">
          <div className="bg-white rounded-xl shadow-2xl w-[90%] max-w-xl max-h-[70vh] flex flex-col">
            <div className="flex items-center justify-between px-4 py-3 border-b">
              <div className="font-semibold text-lg">Select currency</div>
              <button
                onClick={() => setOpen(false)}
                className="text-gray-500 hover:text-gray-800 text-sm"
              >
                Close ✕
              </button>
            </div>

            <div className="px-4 py-3 border-b">
              <input
                type="text"
                placeholder="Search by code or name..."
                className="w-full border rounded-md px-3 py-2 text-sm"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
              />
            </div>

            <div className="flex-1 overflow-auto">
              <ul className="divide-y text-sm">
                {filtered.map((c) => (
                  <li key={c.code}>
                    <button
                      className="w-full text-left px-4 py-2 hover:bg-orange-50 flex items-center gap-2"
                      onClick={() => {
                        onChange(c.code);
                        setOpen(false);
                        setQuery("");
                      }}
                    >
                      <span className="text-lg">{c.flag}</span>
                      <span className="font-semibold">{c.code}</span>
                      <span className="text-gray-600">— {c.name}</span>
                    </button>
                  </li>
                ))}
                {filtered.length === 0 && (
                  <li className="px-4 py-3 text-gray-500">
                    No results found.
                  </li>
                )}
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
